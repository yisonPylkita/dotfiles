#!/usr/bin/env bash
set -eu

tools='starship starship
ripgrep rg
lsd lsd
bat bat
gitui gitui
zellij zellij'

usage() {
    printf 'Usage: %s [all|tools|--list]\n' "$0" >&2
}

if [ "$#" -gt 1 ]; then
    usage
    exit 2
fi

mode=${1:-all}
case "$mode" in
    --list|list)
        printf '%s\n' "$tools"
        exit 0
        ;;
    all|tools) ;;
    *)
        usage
        exit 2
        ;;
esac

: "${HOME:?HOME must be set}"
CARGO_HOME="$HOME/.cargo"
RUSTUP_HOME="$HOME/.rustup"
CARGO_INSTALL_ROOT="$HOME/.cargo"
export CARGO_HOME RUSTUP_HOME CARGO_INSTALL_ROOT
unset RUSTUP_TOOLCHAIN
PATH="$CARGO_HOME/bin:$HOME/.local/bin:${PATH:-}"
export PATH
cd "$HOME"

if [ "$mode" = all ]; then
    "$CARGO_HOME/bin/rustup" update stable
fi

while read -r crate _; do
    "$HOME/.local/bin/cargo-binstall-latest" --force "$crate"
done <<< "$tools"
