#!/usr/bin/env bash
# Report installed Rust toolchains and their disk usage.

set -euo pipefail

rustup_home=${RUSTUP_HOME:-$HOME/.rustup}
toolchain_dir=$rustup_home/toolchains

if [[ ! -d $toolchain_dir ]]; then
	printf 'No Rust toolchains installed.\n'
	exit 0
fi

if toolchain_status=$(rustup toolchain list 2>/dev/null); then
	status_available=true
else
	toolchain_status=
	status_available=false
fi
rows=
count=0
total_kb=0
toolchain_names=()
toolchain_sizes=()

for dir in "$toolchain_dir"/*; do
	[[ -d $dir ]] || continue
	name=${dir##*/}
	size_kb=$(du -sk "$dir" | awk '{print $1}')
	rows+="${size_kb}"$'\t'"${name}"$'\n'
	toolchain_names+=("$name")
	toolchain_sizes+=("$size_kb")
	count=$((count + 1))
	total_kb=$((total_kb + size_kb))
done

if (( count == 0 )); then
	printf 'No Rust toolchains installed.\n'
	exit 0
fi

format_kb() {
	awk -v kb="$1" 'BEGIN {
		if (kb >= 1048576) printf "%.1fG", kb / 1048576
		else if (kb >= 1024) printf "%.0fM", kb / 1024
		else printf "%dK", kb
	}'
}

status_for() {
	printf '%s\n' "$toolchain_status" | awk -v n="$1" '$1 == n { $1 = ""; sub(/^ /, ""); print; exit }'
}

printf 'Installed Rust toolchains: %d (%s total)\n\n' "$count" "$(format_kb "$total_kb")"

printf '%s' "$rows" | sort -rn | while IFS=$'\t' read -r size_kb name; do
	status="$(status_for "$name")"
	if [[ -n $status ]]; then
		printf '  %-6s %s %s\n' "$(format_kb "$size_kb")" "$name" "$status"
	else
		printf '  %-6s %s\n' "$(format_kb "$size_kb")" "$name"
	fi
done

printf '\n'
if [[ $status_available != true ]]; then
	printf 'Toolchain status unavailable; active/default exclusions could not be checked, so no review candidates are listed.\n'
else
	review_count=0
	review_kb=0
	review_names=()
	if (( count > 1 )); then
		for index in "${!toolchain_names[@]}"; do
			name=${toolchain_names[$index]}
			case $name in
				stable|stable-*) continue ;;
			esac
			status="$(status_for "$name")"
			case $status in
				*active*|*default*) continue ;;
			esac
			review_names+=("$name")
			review_count=$((review_count + 1))
			review_kb=$((review_kb + toolchain_sizes[index]))
		done
	fi
	if (( review_count == 0 )); then
		printf 'Additional toolchains for manual review: none.\n'
	else
		printf 'Additional toolchains for manual review: %d (%s total).\n' \
			"$review_count" "$(format_kb "$review_kb")"
		for name in "${review_names[@]}"; do
			printf '  %s\n' "$name"
		done
	fi
	printf 'Project toolchain pins cannot be inferred from this report.\n'
fi
