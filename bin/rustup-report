#!/usr/bin/env bash
# Report installed Rust toolchains, their disk usage, and whether cleanup is worthwhile.

set -euo pipefail

rustup_home=${RUSTUP_HOME:-$HOME/.rustup}
toolchain_dir=$rustup_home/toolchains

if [[ ! -d $toolchain_dir ]]; then
	printf 'No Rust toolchains installed.\n'
	exit 0
fi

toolchain_status=$(rustup toolchain list 2>/dev/null || true)
rows=
count=0
total_kb=0
non_stable_count=0
non_stable_kb=0

for dir in "$toolchain_dir"/*; do
	[[ -d $dir ]] || continue
	name=${dir##*/}
	size_kb=$(du -sk "$dir" | awk '{print $1}')
	rows+="${size_kb}"$'\t'"${name}"$'\n'
	count=$((count + 1))
	total_kb=$((total_kb + size_kb))
	case $name in
		stable-*) ;;
		*)
			non_stable_count=$((non_stable_count + 1))
			non_stable_kb=$((non_stable_kb + size_kb))
			;;
	esac
done

if (( count == 0 )); then
	printf 'No Rust toolchains installed.\n'
	exit 0
fi

format_kb() {
	awk -v kb="$1" 'BEGIN {
		if (kb >= 1048576) printf "%.1fG", kb / 1048576
		else if (kb >= 1024) printf "%.0fM", kb / 1024
		else printf "%dK", kb
	}'
}

printf 'Installed Rust toolchains: %d (%s total)\n\n' "$count" "$(format_kb "$total_kb")"

printf '%s' "$rows" | sort -rn | while IFS=$'\t' read -r size_kb name; do
	status=$(printf '%s\n' "$toolchain_status" | awk -v n="$name" '$1 == n { $1 = ""; sub(/^ /, ""); print }')
	if [[ -n $status ]]; then
		printf '  %-6s %s %s\n' "$(format_kb "$size_kb")" "$name" "$status"
	else
		printf '  %-6s %s\n' "$(format_kb "$size_kb")" "$name"
	fi
done

printf '\n'
if (( non_stable_count == 0 )); then
	printf 'Cleanup recommended: no - only the stable toolchain is installed.\n'
else
	printf 'Cleanup recommended: yes - %d non-stable toolchain(s) use %s. Keep one only if a project pins it.\n' \
		"$non_stable_count" "$(format_kb "$non_stable_kb")"
fi
